    {
      "name": "Error: city outside the USA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Toronto, ON\",\n  \"finish\": \"Houston, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
              "pm.test(\"explains the start error\", () => {",
              "    pm.expect(pm.response.json().start[0]).to.include(\"Unknown US state code\");",
              "});"
            ]
          }
        }
      ]
    },
